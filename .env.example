# ---------------------------------------------------------------------------
# TEMPLATE ONLY. Every value below is a placeholder. Never a real key, ever.
# ---------------------------------------------------------------------------
#
# WHERE EACH KIND OF VALUE ACTUALLY GOES
#
#   .env         Committed on purpose. PUBLIC build-time values only — today
#                that is exactly one, the GA4 Measurement ID. Read the header
#                comment in that file before adding anything to it.
#
#   .env.local   Gitignored via the existing "*.local" rule. This is where every
#                secret goes for local development. Copy this file to .env.local
#                and fill it in. `next dev` loads it automatically; the scripts
#                load it via --env-file-if-exists (see package.json).
#
#   Vercel       Project → Settings → Environment Variables, as encrypted
#                values, for Production and Preview. Vercel's values take
#                precedence over .env, because Next.js will not overwrite a
#                variable already present in the process environment.
#
# ANYTHING PREFIXED NEXT_PUBLIC_ IS INLINED INTO THE CLIENT BUNDLE AT BUILD TIME
# and is readable by anyone who views source. Nothing secret may carry that
# prefix. The two publishable keys below are safe by design; nothing else is.
#
# Every variable here is OPTIONAL as far as the build is concerned. `npm run
# build` succeeds with none of them set, and each feature degrades on its own
# terms rather than crashing — see the fail-closed notes in lib/stripe.ts,
# lib/ga-server.ts and lib/email.ts. That is deliberate: the marketing pages
# must be shippable before the payment account exists.


# ---------------------------------------------------------------------------
# Stripe — billing, and the source of every conversion event
# ---------------------------------------------------------------------------

# Secret API key. sk_test_… against the test account, and for PRODUCTION prefer a
# RESTRICTED key (rk_live_…) over sk_live_ — a restricted key can be scoped to
# only the resources this app touches (customers, prices, products, checkout
# sessions, subscriptions, invoices, webhooks, account read), so a leak cannot be
# used to move money out or read the whole account history.
# Dashboard → Developers → API keys → Create restricted key.
# Run `npm run stripe:audit` before creating anything, to confirm which account a
# key points at. Test and live have completely separate catalogs.
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key. Public by design — it appears in page source. Not currently
# read by any server code here; documented because Stripe.js needs it if an
# embedded payment element is ever added.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret. THIS IS PER-ENDPOINT, and mixing them up is the single
# most common cause of "signature verification failed":
#   local     `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#             prints a whsec_… on startup. That one is only valid for that CLI
#             session's forwarding.
#   deployed  Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Without it, app/api/stripe/webhook/route.ts returns 500 and every conversion is
# lost — it fails closed rather than trusting an unverified POST.
STRIPE_WEBHOOK_SECRET=whsec_replace_me


# ---------------------------------------------------------------------------
# Cal.com — the scheduler
# ---------------------------------------------------------------------------

# API key. Cal.com → Settings → Developer → API keys.
# API v1 IS DECOMMISSIONED — v2 only (https://api.cal.com/v2), which is what
# lib/calcom.ts uses. Webhooks plus redirect-after-booking are what keep booking
# and card capture one unbroken click apart.
CALCOM_API_KEY=cal_live_replace_me

# Webhook signing secret. Shown when the webhook subscription is created (Cal.com
# → Settings → Developer → Webhooks, or via scripts/calcom-bootstrap.ts). Signed
# HMAC-SHA256 over the raw body. Fails closed: without it,
# app/api/calcom/webhook/route.ts rejects every delivery.
CALCOM_WEBHOOK_SECRET=replace_me

# Event type ids, used to map a booking back to a delivery mode. Read them from
# `npm run calcom:bootstrap` output, or Cal.com → Event Types → the event → URL.
# Mapped by ID rather than by matching the event title, because a title is copy
# and copy gets edited — renaming an event type must never start pricing
# in-person students at online rates.
CALCOM_EVENT_TYPE_ID_ONLINE=
CALCOM_EVENT_TYPE_ID_INPERSON=


# ---------------------------------------------------------------------------
# Analytics — server-side conversions
# ---------------------------------------------------------------------------

# GA4 Measurement Protocol API secret.
# GA4 Admin → Data Streams → (the web stream) → Measurement Protocol API secrets.
# NOT the same thing as the Measurement ID, which is public and lives in .env.
# Without this the server-side conversion is skipped with a warning, the browser
# mirror still fires, and Google Ads ends up bidding on the 70-80% of conversions
# that survive ad blockers and Safari ITP. See lib/ga-server.ts.
GA_API_SECRET=replace_me

# Set to 1 to send conversions to GA4's /debug/mp/collect instead, which returns
# a validationMessages array. The real endpoint answers 204 to absolutely
# anything, including a payload it silently discards, so this is the only way to
# see a rejection. Leave unset in production.
GA_DEBUG_ENDPOINT=


# ---------------------------------------------------------------------------
# Signed links and scheduled jobs
# ---------------------------------------------------------------------------

# HMAC key for the one-click "start my plan" links (lib/booking-token.ts).
# Generate: openssl rand -base64 32
# Minimum 32 characters, enforced in code — a short HMAC key does not error, it
# just becomes forgeable. Rotating it invalidates every plan link already emailed.
BOOKING_LINK_SECRET=replace_me_with_openssl_rand_base64_32

# Bearer token Vercel Cron presents to /api/cron/review-requests.
# Generate: openssl rand -base64 32
# Set it on the Vercel project, not just locally — Vercel reads it at invocation
# time. The route fails closed: with no CRON_SECRET it refuses everything,
# including Vercel's own scheduler, rather than leaving an email-sending endpoint
# open on the public internet.
CRON_SECRET=replace_me_with_openssl_rand_base64_32


# ---------------------------------------------------------------------------
# Email — transactional only
# ---------------------------------------------------------------------------

# Resend API key. resend.com → API Keys. Chosen because it is a plain JSON REST
# endpoint and adds no npm dependency; `vercel integration list` confirmed no
# email provider was already provisioned on this project. The provider sits behind
# send() in lib/email.ts, so swapping it is one function.
# Unset is safe: sends become a logged warning instead of a throw, so builds and
# `stripe listen` runs work without a mail account.
RESEND_API_KEY=re_replace_me

# The From address. MUST be on a domain verified under Resend → Domains, or
# Resend refuses to send. onboarding@resend.dev works but only delivers to the
# account owner's own address — which looks like success while no student ever
# receives anything.
EMAIL_FROM="Juliana Beltran <hello@juliana-beltran.com>"

# Where operator alerts go: payment failures, churn, plan starts, mode mismatches.
# There is no admin dashboard and no error monitoring on this project, so email is
# the alerting channel. Falls back to the public inbox in lib/site.ts if unset.
OPERATOR_EMAIL=replace_me@example.com

# The Google review short link, from Google Business Profile → Ask for reviews.
# Without it the review-request cron does nothing every day and says so in the
# logs — the link is the entire content of that email, so sending one without it
# would waste the single best moment to ask.
GOOGLE_REVIEW_URL=https://g.page/r/replace_me/review


# ---------------------------------------------------------------------------
# Local development conveniences
# ---------------------------------------------------------------------------

# Overrides the canonical origin from lib/site.ts when building Stripe
# success_url / cancel_url and plan links. Set to http://localhost:3000 while
# testing the funnel locally, or Stripe will redirect you to production
# mid-checkout. Leave UNSET in production so the canonical host is used.
NEXT_PUBLIC_SITE_URL=

# Set to 1 to dispatch Vercel custom events alongside GA4. Pre-existing flag —
# see the header of lib/analytics.ts for why it is off by default on Hobby.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS=


# ---------------------------------------------------------------------------
# Meta Pixel — Facebook/Instagram show ads
# ---------------------------------------------------------------------------

# Dataset (Pixel) ID from Meta Events Manager — digits only. Public, like the
# GA4 Measurement ID, so it lives in .env (set 2026-10-22). Loads on /artist/*
# only; unset or malformed disables it. See components/artist/MetaPixel.tsx.
NEXT_PUBLIC_META_PIXEL_ID=
